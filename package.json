{
  "name": "xakumedia",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first Windows Desktop Bulk Media Downloader",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "build": "npm run build:all",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build:frontend": "npm --prefix frontend run build",
    "build:all": "npm run build:frontend && npm run build:desktop",
    "start": "npm run build:all && npx --prefix frontend electron desktop/dist/main.cjs",
    "test": "npm run test:desktop && npm run test:python",
    "test:desktop": "node scripts/build-desktop.mjs && npx --prefix frontend electron desktop/dist/main.cjs --smoke-test",
    "typecheck": "npm run typecheck:frontend",
    "typecheck:frontend": "npm --prefix frontend run typecheck",
    "lint": "npm run lint:python",
    "test:python": ".\\backend\\.venv\\Scripts\\pytest backend/",
    "lint:python": ".\\backend\\.venv\\Scripts\\ruff check backend/",
    "install:frontend": "npm --prefix frontend install",
    "install:backend": ".\\backend\\.venv\\Scripts\\pip install -e \"backend[dev]\"",
    "server:python": "node scripts/run-python-server.mjs",
    "verify": "node scripts/verify-env.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:dry": "node scripts/clean.mjs --dry-run",
    "db:stats": "node scripts/db-tool.mjs stats",
    "run:ps1": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run.ps1"
  }
}
